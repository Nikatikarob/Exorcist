<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070C11"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="monospace"
        android:letterSpacing="0.14"
        android:text="ЭХО-СОНАР"
        android:textColor="#00E5C0"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="НАЖМИ СТАРТ"
        android:textColor="#FFB020"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRange"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="#0D151C"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="— см"
            android:textColor="#7CFF3D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConf"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_height="wrap_content"
            android:background="#0D151C"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="— %"
            android:textColor="#FF2E88"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.exorcist.app.ui.SonarScopeView
        android:id="@+id/scope"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvDiag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="прямой путь: — · SNR: — · разрешение: —"
        android:textColor="#7E93A3"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/lblF0" style="@style/SonarLbl" android:text="Chirp f₀" />
            <SeekBar android:id="@+id/sbF0" style="@style/SonarSeek" android:max="60" android:progress="40" />

            <TextView android:id="@+id/lblF1" style="@style/SonarLbl" android:text="Chirp f₁" />
            <SeekBar android:id="@+id/sbF1" style="@style/SonarSeek" android:max="35" android:progress="35" />

            <TextView android:id="@+id/lblDur" style="@style/SonarLbl" android:text="Длительность" />
            <SeekBar android:id="@+id/sbDur" style="@style/SonarSeek" android:max="14" android:progress="4" />

            <TextView android:id="@+id/lblGain" style="@style/SonarLbl" android:text="Уровень посылки" />
            <SeekBar android:id="@+id/sbGain" style="@style/SonarSeek" android:max="75" android:progress="30" />

            <TextView android:id="@+id/lblRange" style="@style/SonarLbl" android:text="Макс. дальность" />
            <SeekBar android:id="@+id/sbRange" style="@style/SonarSeek" android:max="40" android:progress="20" />

            <TextView android:id="@+id/lblInt" style="@style/SonarLbl" android:text="Период посылки" />
            <SeekBar android:id="@+id/sbInt" style="@style/SonarSeek" android:max="24" android:progress="6" />

            <CheckBox
                android:id="@+id/cbEmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:fontFamily="monospace"
                android:text="Излучать chirp (выключи для тишины)"
                android:textColor="#00E5C0"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="18–23.5 кГц большинство взрослых не слышит, но дети и животные слышат. Держи уровень умеренным."
                android:textColor="#7E93A3"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="СТАРТ"
            android:textColor="#7CFF3D"
            android:textSize="16sp"
            app:strokeColor="#7CFF3D" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="КОПИРОВАТЬ"
            android:textColor="#00E5C0"
            android:textSize="16sp"
            app:strokeColor="#00E5C0" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="monospace"
        android:text="← В МЕНЮ"
        android:textColor="#7E93A3"
        android:textSize="15sp" />

</LinearLayout>
